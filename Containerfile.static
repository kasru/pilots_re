# Build image for the self-contained Linux release binary of the port.
#
# WHY THIS IMAGE EXISTS: the Linux asset in the release is one file with SDL2
# and ffmpeg inside it, so a player does not have to install libSDL2-2.0.so.0
# and the libav* stack before the game starts. The CMake side of that is
# PILOTS_STATIC_SDL2 + PILOTS_STATIC_AV (see CMakeLists.txt); this file is the
# toolchain those two options are built with.
#
# WHAT STAYS DYNAMIC, ON PURPOSE: glibc, and with it the X11/Wayland/ALSA/
# PulseAudio libraries SDL2 links or dlopen()s at runtime. A fully static glibc
# cannot load drivers at runtime, and the whole point of the static link here is
# to drop the two libraries that are NOT part of a desktop - SDL2 and ffmpeg.
#
# WHY BULLSEYE AND NOT A NEWER DEBIAN: the binary can only run where glibc is at
# least as new as the one it was linked against, so the build has to happen on
# the oldest glibc the release is meant to support. Bookworm (glibc 2.36) was
# measured first and produced exactly that floor: 2.36, which refuses to start
# on Ubuntu 22.04 (2.35) and Debian 11 (2.31). Two symbols were the culprits and
# both come from the *environment*, not from our code - Debian's libSDL2.a uses
# arc4random (glibc 2.36) and libavutil's expression parser calls hypot, which
# was re-versioned in 2.35. On bullseye nothing of the sort is available, and
# the result asks for glibc 2.31 - Debian 11, Ubuntu 20.04 and newer.
#
# WHY BOTH LIBRARIES ARE BUILT FROM SOURCE:
#   ffmpeg - Debian's libavcodec.a carries every decoder and encoder the distro
#     enabled (x264, x265, dav1d, jxl, rav1e, SvtAv1, mfx, ...) because
#     av_codec_iterate() keeps a table of all of them, so a static link pulls the
#     lot in - 1653 undefined symbols from two archives under -no-pie, measured -
#     and turns the binary GPL. The port needs exactly one demuxer and three
#     decoders: mci_ffmpeg.c opens AVI, INTRO.AVI/START.AVI are MS RLE and
#     FINAL.AVI is Cinepak (see the strh/strf chunks in SRC/MOVIES). A minimal
#     --disable-everything build links to libc/libm only, stays LGPL-2.1+, and
#     decodes all three files.
#   SDL2 - the distro archive is the one that pulled in arc4random: Debian builds
#     it against the newest glibc and static-links whatever it found there.
#     Building 2.26.5 (the version the Linux port has been tested against) on
#     bullseye gives a static archive that only knows the 2.31 symbols, and
#     -fPIC keeps the image a normal PIE.
#
# Both tarballs are pinned by version AND SHA-256, and ffmpeg's configure runs
# with --disable-network + --disable-autodetect so it does not reach for
# anything else on the machine: its output ends with "License: LGPL version 2.1
# or later".
#
#   podman build --dns 8.8.8.8 --dns 1.1.1.1 -f Containerfile.static -t pilots-static .
#   sh scripts/build_linux_static_podman.sh
FROM debian:bullseye-slim

# Debian 11 left standard support on 31 Aug 2026 and its packages moved to
# archive.debian.org. deb.debian.org still hands out a Release file for
# bullseye, but the pool it points at has been emptied, so a plain
# `apt-get update` + install ends in a wall of "404 Not Found" for every
# package (measured: linux-libc-dev, libc6-dev, curl, alsa-lib, mesa, ...).
# Redirecting to the archive - whose Release files are expired by definition,
# hence Check-Valid-Until off - is the supported way to build from an EOL
# release. A frozen base is what a release build wants anyway: the glibc floor
# this image exists for cannot move under us.
ENV DEBIAN_FRONTEND=noninteractive
RUN sed -i -e 's|deb.debian.org/debian|archive.debian.org/debian|g' \
           -e '/bullseye-backports/d' /etc/apt/sources.list \
 && printf 'Acquire::Check-Valid-Until "false";\n' > /etc/apt/apt.conf.d/99archive \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential cmake pkg-config \
      nasm yasm xz-utils curl ca-certificates \
      libasound2-dev libpulse-dev libudev-dev \
      libx11-dev libxext-dev libxrandr-dev libxcursor-dev libxi-dev \
      libxfixes-dev libxss-dev libxinerama-dev libxxf86vm-dev \
      libxkbcommon-dev libwayland-dev libdrm-dev libgbm-dev \
 && rm -rf /var/lib/apt/lists/*

# Debian 11 ships CMake 3.18, and CMAKE_C_STANDARD 17 only became a legal value
# in CMake 3.21 - the configure step fails with "C_STANDARD is set to invalid
# value '17'" otherwise, and the project needs C17 (game_globals_struct.h
# relies on () not meaning (void), see CMakeLists.txt). So the image carries its
# own CMake from the official binary tarball, pinned by version AND SHA-256
# like everything else here. The binary is x86_64 and self-contained, which is
# the whole point of taking it from upstream rather than from a newer distro.
ARG CMAKE_VERSION=3.27.9
ARG CMAKE_SHA256=72b01478eeb312bf1a0136208957784fe55a7b587f8d9f9142a7fc9b0b9e9a28

RUN cd /tmp \
 && curl -fsSL -o cmake.tar.gz \
      "https://github.com/Kitware/CMake/releases/download/v${CMAKE_VERSION}/cmake-${CMAKE_VERSION}-linux-x86_64.tar.gz" \
 && echo "${CMAKE_SHA256}  cmake.tar.gz" | sha256sum -c - \
 && tar xf cmake.tar.gz \
 && mv "cmake-${CMAKE_VERSION}-linux-x86_64" /opt/cmake \
 && rm cmake.tar.gz \
 && /opt/cmake/bin/cmake --version

ENV PATH=/opt/cmake/bin:$PATH

# SDL2 2.26.5: the version every Linux build of the port has run against. Only
# the backends the -dev packages above provide get compiled in (X11, Wayland,
# KMSDRM, ALSA, PulseAudio, dummy); jack, pipewire and libdecor are absent by
# not being installed, which is also why the release does not need them.
ARG SDL2_VERSION=2.26.5
ARG SDL2_SHA256=ad8fea3da1be64c83c45b1d363a6b4ba8fd60f5bde3b23ec73855709ec5eabf7

# The tarball comes from the GitHub release, not from www.libsdl.org: the
# libsdl.org host refuses connections from some networks (measured: "Failed to
# connect ... port 443: Connection refused" on two unrelated machines), while
# GitHub serves the byte-identical file - same 8085012 bytes, same SHA-256,
# verified. The hash is what actually pins the content, so the mirror only has
# to be reachable.
RUN cd /tmp \
 && curl -fsSL -o "SDL2-${SDL2_VERSION}.tar.gz" \
      "https://github.com/libsdl-org/SDL/releases/download/release-${SDL2_VERSION}/SDL2-${SDL2_VERSION}.tar.gz" \
 && echo "${SDL2_SHA256}  SDL2-${SDL2_VERSION}.tar.gz" | sha256sum -c - \
 && tar xf "SDL2-${SDL2_VERSION}.tar.gz" \
 && cd "SDL2-${SDL2_VERSION}" \
 && CFLAGS="-O2 -fPIC" ./configure --prefix=/opt/sdl2 \
      --disable-shared --enable-static \
 && make -j"$(nproc)" \
 && make install \
 && cd /tmp \
 && rm -rf "SDL2-${SDL2_VERSION}" "SDL2-${SDL2_VERSION}.tar.gz"

# ffmpeg 5.1.9 is the version Debian bookworm ships, i.e. the one the port's
# Linux builds have been tested against; only the component set differs.
ARG FFMPEG_VERSION=5.1.9
ARG FFMPEG_SHA256=d9b593bb2ba93d4b50f74177e0cdcd41747e708596367deed0c30348a71dd176

RUN cd /tmp \
 && curl -fsSLO "https://ffmpeg.org/releases/ffmpeg-${FFMPEG_VERSION}.tar.xz" \
 && echo "${FFMPEG_SHA256}  ffmpeg-${FFMPEG_VERSION}.tar.xz" | sha256sum -c - \
 && tar xf "ffmpeg-${FFMPEG_VERSION}.tar.xz" \
 && cd "ffmpeg-${FFMPEG_VERSION}" \
 && ./configure --prefix=/opt/ffmpeg \
      --disable-shared --enable-static --enable-pic \
      --disable-programs --disable-doc --disable-network --disable-autodetect \
      --disable-everything \
      --enable-avformat --enable-avcodec --enable-avutil \
      --enable-swscale --enable-swresample \
      --enable-demuxer=avi \
      --enable-decoder=msrle,cinepak,rawvideo \
      --enable-protocol=file \
 && make -j"$(nproc)" \
 && make install \
 && cd /tmp \
 && rm -rf "ffmpeg-${FFMPEG_VERSION}" "ffmpeg-${FFMPEG_VERSION}.tar.xz"

# pkg-config must find these builds, not a distro libSDL2/libav* that a later
# layer or the mounted source tree might bring in.
ENV PKG_CONFIG_PATH=/opt/sdl2/lib/pkgconfig:/opt/ffmpeg/lib/pkgconfig
