# build outputs (dropped into SRC/ by the build bats, or build/ by CMake on Linux)
*.obj
*.exe
*.pdb
*.map
*.ilk
*.dll
*_debug.log
build/

# third_party SDKs are committed as-is (SDL2.dll must not be ignored)
!third_party/**

# original game data and saves - never commit
*.SAV
PILOTS.iso
PILOTS0
PILOTS0.*
